# PostgreSQL ma'lumotlar bazasi (Supabase yoki Fly.io dan olingan)
DATABASE_URL=postgres://user:password@host:port/database

# Yoki alohida:
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password
# DB_NAME=your-db-name

# Server port
PORT=8080

# Muhit (production yoki development)
NODE_ENV=production
